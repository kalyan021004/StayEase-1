# ---------------------------------------------------------------------------
# StayEase backend configuration. Copy to .env for local dev (never commit .env).
# The API, worker and scheduler all read the same variables and REFUSE TO
# START if a required one is missing - you get a list of what's wrong.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development            # development | test | production
PORT=5000
LOG_LEVEL=info                  # fatal|error|warn|info|debug|trace|silent
CORS_ORIGIN=http://localhost:5173   # comma-separated list of allowed frontend origins
TRUST_PROXY=0                   # set to 1 behind a load balancer / reverse proxy

# --- Postgres (required) ---------------------------------------------------
DATABASE_URL=postgres://stayease:stayease@localhost:5432/stayease
DB_POOL_MAX=10

# --- Auth (required) -------------------------------------------------------
# At least 32 chars. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# Brute-force protection on /auth/login and /auth/signup (per IP, per route)
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=900000

# --- Redis (required: cache + job queue) -----------------------------------
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=120

# --- Razorpay (required) ---------------------------------------------------
# Free test keys: https://dashboard.razorpay.com -> Settings -> API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
# Set when creating the webhook in Razorpay (Settings -> Webhooks), event: payment.captured
RAZORPAY_WEBHOOK_SECRET=change-me-webhook-secret

# --- Object storage, S3-compatible (required: Excel exports) ---------------
# Local docker uses MinIO (values below). Production: Cloudflare R2 or AWS S3.
#   R2:  S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto  S3_FORCE_PATH_STYLE=false
#   S3:  leave S3_ENDPOINT empty, S3_REGION=ap-south-1
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=             # only if browsers reach storage at a different URL (docker: http://localhost:9000)
S3_REGION=us-east-1
S3_BUCKET=stayease-exports
S3_ACCESS_KEY_ID=stayease
S3_SECRET_ACCESS_KEY=stayease-secret
S3_FORCE_PATH_STYLE=true        # true for MinIO

# --- Billing schedule (scheduler process only, optional) -------------------
BILLING_CRON=0 2 1 * *
BILLING_TZ=Asia/Kolkata
